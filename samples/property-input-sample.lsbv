    <mapping source="0d52da01-453a-492a-a4ea-86e4049ea716">
      <target>f543d7a7-427f-48ed-8c7f-ffe36fc75034</target>
    </mapping>
    <!-- multi-choice -->
    <mapping source="fed3d396-af6f-46de-b025-9e4433e30b53">
      <target>18ac33da-1d3b-4854-a6b4-1db54435d81b</target>
    </mapping>
    <!-- date -->
    <mapping source="8e8c45e7-f5e3-44ad-9694-922bae3cdc9a">
